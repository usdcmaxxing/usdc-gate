# USDC Gate — configuration. Copy to .env and fill in. Never commit .env.

# ── x402 ────────────────────────────────────────────────────────────────────
# Network: Base Sepolia (testnet) or Base mainnet.
X402_NETWORK=eip155:84532
PRICE=$0.02
FACILITATOR=https://x402.org/facilitator

# Seller wallet. On mainnet this is the address that receives the $0.02
# payments — keep it a dedicated hot wallet, never a contract or a shared vault.
# If unset, a throwaway key is generated and printed (testnet demo only).
SELLER_PRIVATE_KEY=
PAY_TO=

# ── chain ───────────────────────────────────────────────────────────────────
CHAIN_KEY=base-sepolia
PORT=4021

# ── flow checks (real chain history) ────────────────────────────────────────
FLOW_ENABLED=true
# auto | blockscout | logs
FLOW_SOURCE=auto
FLOW_WINDOW_BLOCKS=50000
FLOW_LIMIT=200
FLOW_TTL_MS=300000
FLOW_TIMEOUT_MS=4000

# RPC endpoints used by the eth_getLogs fallback. Public endpoints are
# rate-limited; set a paid key for production.
RPC_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com
RPC_BASE=https://base-rpc.publicnode.com

# Blockscout (richer history; used when reachable)
BLOCKSCOUT_BASE_SEPOLIA=https://base-sepolia.blockscout.com
BLOCKSCOUT_BASE=https://base.blockscout.com

# ── policy ─────────────────────────────────────────────────────────────────
AMOUNT_CEILING=100000
AMOUNT_FLOOR=0.000001
